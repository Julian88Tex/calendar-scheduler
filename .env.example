# Kairos environment variables (ARCHITECTURE section 22). EVERY variable is optional: with none set, the app runs
# locally on an embedded PGlite database and hides integrations that are not configured. Copy to .env.local for local
# overrides (git ignored). On Vercel, set them in Project Settings > Environment Variables.

# --- Database ------------------------------------------------------------------------------------------------------
# Postgres connection (pooled is fine; Neon's Storage tab integration sets these). Unset locally: PGlite in .data/pglite.
# Unset on Vercel: every page shows the setup page and APIs answer 503 {"error":"setup_required"}.
DATABASE_URL=
# Legacy Vercel Postgres name, used when DATABASE_URL is unset.
POSTGRES_URL=
# Direct (unpooled) URLs for migrations; fall back to the pooled URL.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
# Vercel previews never migrate (the preview may share the production database) unless this is 1. Set it for the
# Preview environment only when Neon preview branching gives each preview its own database.
MIGRATE_ON_PREVIEW=
# Local PGlite directory (default .data/pglite). Never share one directory between two processes.
PGLITE_DIR=

# --- App ------------------------------------------------------------------------------------------------------------
# Canonical origin for OAuth redirects and email links. Default: the Vercel production URL, else http://localhost:3000.
APP_URL=
# Product name shown everywhere (default Kairos).
NEXT_PUBLIC_APP_NAME=
# Crypto keys (any string; the key is its SHA-256). Generated once and stored in the database when unset. Setting
# ENCRYPTION_KEY in the environment is recommended: then a database backup alone cannot decrypt stored tokens.
# Changing ENCRYPTION_KEY later makes stored tokens unreadable (connections then ask to reconnect).
SESSION_SECRET=
ENCRYPTION_KEY=
# Protects GET /api/cron (Vercel Cron and GitHub Actions send "Authorization: Bearer <CRON_SECRET>"). Unset: the
# endpoint stays open but throttled to one 20 second run per minute.
CRON_SECRET=
# Comma separated emails that are instance admins in addition to the first user.
ADMIN_EMAILS=
# Overrides the instance signup policy: invite_only | open | domains.
SIGNUP_POLICY=
# Logging level: debug | info | warn | error (default info).
LOG_LEVEL=

# --- Owner bootstrap (docs/DEPLOY.md) ---------------------------------------------------------------------------------
# Bearer secret that authorizes POST /api/setup/bootstrap ("Authorization: Bearer <SETUP_TOKEN>"), which creates the
# owner account of a fresh instance and applies the owner's setup. At least 24 characters (shorter values are ignored);
# for example `openssl rand -base64 32`. A CRON_SECRET of at least 24 characters works too. Unset: the endpoint is off.
SETUP_TOKEN=
# The owner's email address. When set, the bootstrap only accepts this address, and only this address becomes the
# instance admin by signing up first, with Google or Microsoft (which verify it; a password signup does not, and anyone
# else follows the signup policy). Case and spaces do not matter. A malformed value disables both instead of accepting
# any email.
OWNER_EMAIL=

# --- Google (sign in, Google Calendar, Google Meet, emails from the owner's Gmail, poll voter free/busy) ---------------
# Redirect URI to register: {APP_URL}/api/auth/google/callback. Enable the Google Calendar API and the Gmail API in the
# same Google Cloud project, and list the gmail.send scope on the consent screen (docs/GOOGLE_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JSuite single sign in (https://github.com/Julian88Tex/JSuite) ------------------------------------------------
# JSuite's URL. Set: the login page shows "Continue with JSuite" and /api/auth/jsuite accepts its hand-off tokens.
JSUITE_URL=

# --- Microsoft (sign in, Outlook calendar, Teams) -------------------------------------------------------------------
# Redirect URI to register: {APP_URL}/api/auth/microsoft/callback (account types: any organizational directory and
# personal Microsoft accounts). Tenant defaults to "common".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# --- Zoom -------------------------------------------------------------------------------------------------------------
# Redirect URI to register: {APP_URL}/api/integrations/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Jitsi ------------------------------------------------------------------------------------------------------------
# Jitsi server for generated meeting links (default https://meet.jit.si).
JITSI_BASE_URL=

# --- Email -----------------------------------------------------------------------------------------------------------
# The first that applies sends: EMAIL_PROVIDER when set, then Resend (RESEND_API_KEY), then SMTP (SMTP_HOST), then the
# owner's own Gmail, else every email is stored in the outbox (Settings > Email outbox) and not sent.
# The owner's Gmail needs no variable: the owner (the first account) connects Google and allows "Send email on your
# behalf"; Integrations > Google Calendar > "Send emails from your Gmail" shows the sending address and turns it off
# or on. Emails then go out as "Owner Name <owner@gmail.com>" and appear in the owner's Gmail Sent folder.
# EMAIL_PROVIDER forces one transport: gmail | resend | smtp | outbox.
#   gmail   sends from the owner's Gmail even when RESEND_API_KEY or SMTP_HOST is set (emails wait in the outbox until
#           Google is connected with Gmail sending allowed); the switch on the Integrations page is then read only.
#   resend  or smtp: that transport (ignored, with a warning in the logs, when its variables below are missing).
#   outbox  stores every email without sending it (staging and demo deployments).
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465).
SMTP_SECURE=
# Sender address for Resend and SMTP. Default: "{AppName}" <notifications@{APP_URL host}>. Gmail always sends as the
# owner's name and Gmail address.
EMAIL_FROM=

# --- SMS (Twilio; unset: messages are stored in the SMS log) --------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number (E.164) or a messaging service.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Payments (Stripe; unset: payments are hidden) ------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Webhook endpoint to register: {APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# With the publishable key the booking page shows the inline Payment Element; without it, a Checkout redirect.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PayPal (P3; unset: hidden) -------------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=

# --- Bot protection (Cloudflare Turnstile; unset: honeypot and timing checks only) ----------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Uploads (Vercel Blob; unset: file bytes are stored in the database) --------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Tuning ---------------------------------------------------------------------------------------------------------
# Booking page busy cache TTL in seconds (default 180).
CALENDAR_CACHE_TTL_SECONDS=
# Self-hosted in-process job poller interval in seconds (default 30; the poller never runs on Vercel).
JOBS_POLL_INTERVAL_SECONDS=
# Self-hosted only: comma separated private host names that safeFetch may reach (for example a LAN Nextcloud
# CalDAV server). Ignored on Vercel.
SAFE_FETCH_ALLOW_HOSTS=

# --- Development and tests ------------------------------------------------------------------------------------------
# Build output directory (default .next); parallel dev servers and e2e runs use their own.
NEXT_DIST_DIR=
# Enables /api/test/* (refused whenever VERCEL is set) and disables the in-process poller. Playwright sets it.
E2E_TEST_MODE=
# Required x-e2e-secret header for /api/test/* (Playwright generates one per run). Unset: /api/test/* answers 404.
E2E_SECRET=
# Real Postgres for race tests (npm run test:pg sets it from embedded-postgres). Unset: those tests are skipped.
TEST_DATABASE_URL=
