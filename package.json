{
  "name": "julendly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "scripts/heavy.sh tsc npm run typecheck:raw",
    "typecheck:raw": "next typegen && tsc --noEmit",
    "typecheck:owned": "node scripts/typecheck-owned.mjs",
    "test": "vitest run",
    "test:pg": "node scripts/with-embedded-pg.mjs vitest run --project pg",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "NODE_OPTIONS=--import=./scripts/server-only-hook.mjs tsx scripts/seed.ts",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/figtree": "5.3.0",
    "@radix-ui/react-accordion": "1.3.0",
    "@radix-ui/react-alert-dialog": "1.2.0",
    "@radix-ui/react-checkbox": "1.4.0",
    "@radix-ui/react-collapsible": "1.2.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-hover-card": "1.2.0",
    "@radix-ui/react-popover": "1.3.0",
    "@radix-ui/react-radio-group": "1.5.0",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.0",
    "@radix-ui/react-tabs": "1.2.0",
    "@radix-ui/react-toast": "1.3.0",
    "@radix-ui/react-toggle-group": "1.2.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@stripe/stripe-js": "10.0.0",
    "arctic": "3.7.0",
    "clsx": "2.1.1",
    "date-holidays": "3.37.0",
    "drizzle-orm": "0.45.4",
    "ical-generator": "11.1.2",
    "jose": "^6.2.13",
    "lucide-react": "1.55.0",
    "luxon": "3.7.2",
    "next": "16.4.0",
    "node-ical": "0.27.3",
    "nodemailer": "10.1.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "tsdav": "2.4.0",
    "undici": "7.30.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "^22",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9",
    "vitest": "5.0.3"
  }
}
